# ==============================================================================
# KONFIGURASI DOCKER - BERDAMPAK UTAMA (LARAVEL 13)
# ==============================================================================
# Cara pakai cepat:
# 1. Ganti nilai yang bertanda [WAJIB GANTI DI SERVER ASLI] di bawah ini.
# 2. Jalankan: docker compose --env-file .env.docker up -d --build
# 3. Buka browser ke http://IP-SERVER:8080 (atau sesuai APP_PORT / domain Anda).
# ==============================================================================

# --- 1. IDENTITAS & ENVIRONMENT APLIKASI ---
APP_NAME="Berdampak Utama Widyatama"
# Gunakan "production" untuk server publik/VPS, atau "local" untuk uji coba
APP_ENV=production
# Set "false" saat live di publik agar detail error kode tidak bocor ke pengunjung
APP_DEBUG=false

# [OPSIONAL TAPI DISARANKAN DI SERVER ASLI]
# Jika dikosongkan, container otomatis membuat dan menyimpan APP_KEY di volume storage/app/.docker_app_key.
# Untuk membuat kunci sendiri, jalankan di terminal:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# [WAJIB GANTI DI SERVER ASLI]
# Sesuaikan dengan alamat yang dibuka di browser (tanpa garis miring di akhir).
# Contoh lokal VPS: http://localhost:8080 atau http://103.xxx.xxx.xxx:8080
# Contoh pakai domain + HTTPS: https://berdampak.widyatama.ac.id
APP_URL=http://localhost:8080

# Port host luar yang memetakan port 80 container Docker (ubah ke 80 atau 8080 sesuai kebutuhan)
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# --- 2. KEAMANAN, SESSION & LOGGING ---
BCRYPT_ROUNDS=12

# Kirim log Laravel ke stderr agar bisa dipantau via "docker compose logs -f app"
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Session disimpan di database agar aman dan konsisten
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Biarkan tidak diisi: cookie otomatis diberi flag Secure saat diakses lewat HTTPS.
# Isi true untuk memaksa Secure (wajib HTTPS penuh); jangan isi false di server publik.
# SESSION_SECURE_COOKIE=true

# --- 3. DATABASE MYSQL (TERHUBUNG OTOMATIS KE SERVICE "db" DI DOCKER COMPOSE) ---
# JANGAN ubah DB_HOST menjadi 127.0.0.1 jika memakai docker-compose.yml bawaan, biarkan "db".
# Jika memakai MySQL eksternal (Managed DB / host terpisah), ubah DB_HOST ke IP/host DB Anda.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=berdampak_utama
DB_USERNAME=berdampak_user

# [WAJIB GANTI DI SERVER ASLI] Gunakan password acak yang kuat sebelum deploy publik
DB_PASSWORD=ganti_password_db_ini
DB_ROOT_PASSWORD=ganti_root_password_ini

# --- 4. STORAGE, CACHE & QUEUE ---
FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- 5. OTOMATISASI STARTUP CONTAINER DOCKER ---
# Menjalankan "php artisan migrate --force" otomatis saat container menyala
DOCKER_AUTO_MIGRATE=true
# Menjalankan "php artisan db:seed --force" otomatis HANYA saat tabel users masih kosong
# (Membuat akun admin default, daftar tech stack, dan contoh proyek awal)
DOCKER_AUTO_SEED_IF_EMPTY=true
# Batas tunggu maksimal (detik) sebelum menyerah menunggu database siap
DOCKER_WAIT_DB_TIMEOUT=60

# --- 6. EMAIL (OPSIONAL) ---
# Default "log" agar tidak error jika SMTP belum dikonfigurasi
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@widyatama.ac.id"
MAIL_FROM_NAME="${APP_NAME}"
